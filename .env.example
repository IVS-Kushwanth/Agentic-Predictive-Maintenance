# ==============================================================================
# Agentic Predictive Maintenance Framework — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your deployment environment:
#   cp .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR SENSITIVE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# FastAPI Backend Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Streamlit Frontend Configuration
STREAMLIT_PORT=8501

# ------------------------------------------------------------------------------
# 2. Frontend-to-Backend Networking
# ------------------------------------------------------------------------------
# In local development: http://localhost:8000
# In Docker Compose:   http://backend:8000
# In cloud deployment: https://your-fastapi-backend.onrender.com
BACKEND_API_URL=http://localhost:8000

# Permitted CORS Origins (comma-separated URLs)
# Include your frontend URL(s) to allow cross-origin requests
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ------------------------------------------------------------------------------
# 3. Database & Storage Configuration
# ------------------------------------------------------------------------------
# Path to persistent SQLite database file
# In Docker or cloud volume: /app/data/maintenance_history.db
DATABASE_PATH=data/maintenance_history.db

# ------------------------------------------------------------------------------
# 4. Optional LLM Integration (LangGraph Decision Support)
# ------------------------------------------------------------------------------
# NOTE: The core multi-agent system runs 100% locally and deterministically
# using trained ML/DL models, anomaly detectors, and TreeSHAP.
# External LLM keys are completely optional and only enrich narrative summaries.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
